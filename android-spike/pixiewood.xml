<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
	<metainfo vercalc="count">
		<xi:include href="build://aarch64/io.github.diegopvlk.Dosage.Spike.metainfo.xml" parse="xml"/>
	</metainfo>
	<style>
		<theme name="adw"/>
		<icon type="generate">
			<drawable target="foreground" scale=".5" type="svg" path="src://data/icon.svg"/>
			<color target="background">#FFFFFF</color>
			<drawable target="monochrome" scale=".5" type="svg" path="src://data/icon-symbolic.svg"/>
		</icon>
	</style>
	<dependencies>
		<glib>
			<patch>hack</patch>
		</glib>
		<fontconfig/>
		<gtk/>
		<libadwaita/>
	</dependencies>
	<build target="dosage-spike">
		<architectures>
			<arch>aarch64</arch>
			<arch>x86_64</arch>
		</architectures>
	</build>
</app>
