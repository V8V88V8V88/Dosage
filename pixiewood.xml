<?xml version="1.0" encoding="UTF-8"?>
<!-- Android build manifest for Pixiewood: see android/README.md -->
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
	<metainfo vercalc="count">
		<xi:include href="build://aarch64/data/io.github.diegopvlk.Dosage.android.metainfo.xml" parse="xml"/>
	</metainfo>
	<style>
		<theme name="adw"/>
		<icon type="generate">
			<drawable target="foreground" scale=".5" type="svg" path="src://data/icons/hicolor/scalable/apps/io.github.diegopvlk.Dosage.svg"/>
			<color target="background">#FFFFFF</color>
			<drawable target="monochrome" scale=".5" type="svg" path="src://data/icons/hicolor/symbolic/apps/io.github.diegopvlk.Dosage-symbolic.svg"/>
		</icon>
	</style>
	<dependencies>
		<glib>
			<patch>hack</patch>
		</glib>
		<fontconfig/>
		<gtk/>
		<libadwaita/>
	</dependencies>
	<build target="dosage">
		<architectures>
			<arch>aarch64</arch>
			<!-- <arch>x86_64</arch> (emulator; slows builds) -->
		</architectures>
	</build>
</app>
